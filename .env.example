# Pick a port for the local server (default is 3000)
PORT=3000

# Put in at least one LLM key here so Greg can think.
# Pick whatever you normally use: Claude, OpenAI, Gemini, Groq, or local Ollama.

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Groq (super fast, https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# If you run Ollama locally on your own machine, flip this to true
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# Need at least one search key here so Greg can check real web data instead of making things up.
# Tavily works great and gives 1,000 free searches a month.

# Tavily (recommended: https://tavily.com)
TAVILY_API_KEY=

# Brave Search (free tier at https://brave.com/search/api/)
BRAVE_API_KEY=

# Serper (Google search API: https://serper.dev)
SERPER_API_KEY=

# Optional: used by npm run sync to push commits straight to GitHub
GITHUB_PAT=
GITHUB_OWNER=anosistaken
GITHUB_REPO=ResearchingAgent
